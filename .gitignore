# ==============================================================================
# .gitignore for ASP.NET Core (.NET 9/10) + ReactJS (Vite / Node) Full-stack
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. .NET & Visual Studio
# ------------------------------------------------------------------------------
# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
!**/logs/.gitkeep

# Visual Studio files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.ide/
*.swp

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider / IntelliJ
.idea/
*.DotSettings.user

# NuGet Packages & Cache
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# Entity Framework & SQL Server local DB files
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal

# Publish & Release output
publish/
[Aa]pp[Dd]ata/
*.PublishSettings

# ASP.NET Core secrets and local overrides
appsettings.Local.json
appsettings.Production.json
secrets.json

# ------------------------------------------------------------------------------
# 2. Node.js & ReactJS (Vite / NPM / PNPM / Yarn)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Production Build outputs
dist/
dist-ssr/
build/
*.local

# Environment variables & secrets (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# NPM / Vite / Yarn logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Operating System files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# ------------------------------------------------------------------------------
# 4. Antigravity / Temporary & Scratch files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
build_*.log
infra_*.log
msbuild.log
