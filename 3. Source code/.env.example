# ===== FRONTEND (Vite – có tiền tố VITE_, được nhúng vào trang web nên chỉ đặt giá trị CÔNG KHAI) =====
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Tên miền email nội bộ để ánh xạ "tên đăng nhập" -> email (kimvui -> kimvui@cherrylaundry.vn). Không cần là email thật.
# Phải TRÙNG với tên miền dùng khi tạo tài khoản trong Supabase (xem README, seed.sql).
VITE_AUTH_EMAIL_DOMAIN=cherrylaundry.vn
# Chỉ dùng khi `npm run dev`: địa chỉ `vercel dev`
VITE_API_PROXY=http://localhost:3000

# ===== BACKEND (Vercel Functions trong thư mục api/ – KHÔNG có tiền tố VITE_, không lộ ra trình duyệt) =====
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# KHÔNG đặt service_role key ở đây: các hàm API chạy bằng quyền của người đăng nhập (JWT) để RLS/phân quyền luôn có hiệu lực.

# ===== SCRIPT IMPORT (scripts/import-legacy.mjs – chạy trên máy bạn, không deploy) =====
IMPORT_USERNAME=kimvui
IMPORT_PASSWORD=
